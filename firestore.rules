rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "admin@marketbd.net" ||
        request.auth.token.email == "official.marketbd@gmail.com" ||
        request.auth.token.admin == true
      );
    }

    // Products / Classified Ads
    match /products/{productId} {
      allow read: if true; // Public marketplace reading
      allow create: if isSignedIn() || isAdmin();
      allow update, delete: if isSignedIn() && (
        resource.data.sellerId == request.auth.uid ||
        resource.data.seller.id == request.auth.uid ||
        isAdmin()
      );
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Chat System & Direct Messages
    match /chats/{chatId} {
      allow read, write: if isSignedIn() || isAdmin();

      match /messages/{messageId} {
        allow read, write: if isSignedIn() || isAdmin();
      }
    }

    // Customer Care & System Activity Logs
    match /activities/{activityId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // System Settings & Site Configuration
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
